clear all;
close all;

syms z1 z2 z3 z4 u1 u2 alpha

r1 = 1;
r2 = 1;
r3 = 2;
r4 = 4;

s1 = 1;
s2 = 2;

%% original system
a = 1/(cos(z2)+1);

f_orig = u1 * [cos(0.5*(z_2-z_3)); 0; -2*a*sin(z2); 2*sin(0.5*(z_2-z_3))-2*a*sin(z2)] +...
         u2 * [0; 1; 1-2*a; 1-2*a];

h = u1 * [1; 0; -z2; -z3];


%% res1
res1 = cos(0.5*(alpha^r2*z2-alpha^r3*z3))*alpha^s1*u1;

res1_taylor = taylor(res1,[z1 z2 z3 z4],[0 0 0 0],'Order', 1)
res1_taylor = taylor(res1,[z1 z2 z3 z4],[0 0 0 0],'Order', 2)
res1_taylor = taylor(res1,[z1 z2 z3 z4],[0 0 0 0],'Order', 3)
res1_taylor = taylor(res1,[z1 z2 z3 z4],[0 0 0 0],'Order', 4)