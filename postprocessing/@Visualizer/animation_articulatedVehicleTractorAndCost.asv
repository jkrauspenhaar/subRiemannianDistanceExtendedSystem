function animation_articulatedVehicleTractorAndCost(obj,trajectoryx, cost, vehicle, save_video)
    if save_video
        videoName = vehicle.Name;
        v = VideoWriter(strcat('results/',videoName,'.avi'), 'Motion JPEG AVI');
        v.FrameRate = 30;
        open(v);
    end

    x = trajectoryx.data;          

    x_robot = x(:,1);
    y_robot = x(:,2);
    theta_robot = x(:,3);
    gama = x(:,4);
    %gama = theta_robot-theta_trailer
    theta_trailer = theta_robot - gama;

    robot_width = vehicle.tractor.width_tractor;
    robot_length = vehicle.tractor.length_tractor;

    trailer_width = vehicle.tractor.widtht_tractor;
    trailer_length  = vehicle.tractor.lengtht_tractor;

        % obj.width_tractor = data_config.width_tractor_val;
        % obj.length_tractor = data_config.length_tractor_val;
        % obj.widtht_tractor = data_config.widtht_tractor_val;
        % obj.lengtht_tractor = data_config.lengtht_tractor_val;

    l = vehicle.l; %robot to joint
    l_t = vehicle.l_t; %joint to trailer

    x_G = x_robot - l*cos(theta_robot);
    y_G = y_robot - l*sin(theta_robot);

    x_trailer = x_robot - l*cos(theta_robot) - l_t*cos(theta_trailer);
    y_trailer = y_robot - l*sin(theta_robot) - l_t*sin(theta_trailer);

    % margins                
    margin = 1.5*vehicle.axisLength;
    xmin = min([x_robot; x_trailer]) - margin;
    xmax = max([x_robot; x_trailer]) + margin;
    ymin = min([y_robot; y_trailer]) - margin;
    ymax = max([y_robot; y_trailer]) + margin;

    fig = figure('Units','pixels');
    set(fig, 'Resize', 'off');
    t = tiledlayout(fig, 1, 3);

    %left plot
    ax1 = nexttile(t, [1 2]);
    axis(ax1, 'equal');
    axis(ax1, [xmin xmax ymin ymax]);
    grid(ax1, 'on');
    hold(ax1, 'on');
    xlabel(ax1, '$q_1$ in m','Interpreter','latex');
    ylabel(ax1, '$q_2$ in m','Interpreter','latex');
    % title(ax1, 'vehicle');

    %right plot
    ax2 = nexttile(t, 3);
    % axis(ax2, 'equal');
    grid(ax2, 'on');
    hold(ax2, 'on');
    xlabel(ax2, 'time in s','Interpreter','latex');
    ylabel(ax2, 'value function','Interpreter','latex');
    % title(ax2, 'cost');
    time_array = cost.timeGrid();


    % robot    
    h_robot = patch(ax1, nan, nan, [0.2 0.6 0.9], ...
        'FaceAlpha', 0.7);      
    h_center_robot = plot(ax1,nan, nan, 'ko', 'MarkerFaceColor', 'k', 'MarkerSize', 4);
    h_heading_robot = plot(ax1,nan, nan, 'k-', 'LineWidth', 2);

    % G
    h_center_G = plot(ax1,nan, nan, 'ko', 'MarkerFaceColor', 'k', 'MarkerSize', 4);
    

    % trailer    
    h_trailer = patch(ax1,nan, nan, [0.9 0.5 0.2], 'FaceAlpha', 0.7);
    h_center_trailer = plot(ax1,nan, nan, 'ko', 'MarkerFaceColor', 'k', 'MarkerSize', 4);
    h_heading_trailer = plot(ax1,nan, nan, 'k-', 'LineWidth', 2);

    % hook link
    h_link1 = plot(ax1,nan, nan, 'k-', 'LineWidth', 1.5);
    h_link2 = plot(ax1,nan, nan, 'k-', 'LineWidth', 1.5);

    for k = 1:length(x_robot)
        %robot trajectory
        plot(ax1,x_robot(1:k), y_robot(1:k), '--', 'LineWidth', 1,'Color',[0.2 0.6 0.9]);
        %trailer trajectory
        plot(ax1,x_trailer(1:k), y_trailer(1:k), '--', 'LineWidth', 1,'color',[0.9 0.5 0.2]);

        p_robot = [x_robot(k); y_robot(k)];
        p_G = [x_G(k); y_G(k)];
        p_trailer = [x_trailer(k); y_trailer(k)];
        xOffset = 0;
        p_tralier_shifted = p_trailer + xOffset * [cos(theta_trailer(k)); sin(theta_trailer(k))];

        rounding_radius = 0.25 * min(robot_length, robot_width);
        nArc = 20;
        robot_xy = obj.orientedRoundedRectangle(p_robot, theta_robot(k), robot_length, robot_width,rounding_radius,nArc);
        set(h_robot, 'XData', robot_xy(1,:), 'YData', robot_xy(2,:));
        set(h_center_robot, 'XData', p_robot(1), 'YData', p_robot(2));
        
        % G
        set(h_center_G, 'XData', p_G(1), 'YData', p_G(2));

        % trailer
        trailer_xy = obj.orientedRoundedRectangle(p_tralier_shifted, theta_trailer(k), trailer_length, trailer_width,rounding_radius,nArc);
        set(h_trailer, 'XData', trailer_xy(1,:), 'YData', trailer_xy(2,:));
        set(h_center_trailer, 'XData', p_trailer(1), 'YData', p_trailer(2));

        % hook link
        set(h_link1, 'XData', [p_robot(1), p_G(1)], ...
                    'YData', [p_robot(2), p_G(2)]);
        set(h_link2, 'XData', [p_G(1), p_trailer(1)], ...
                    'YData', [p_G(2), p_trailer(2)]);

        % direction arrow
        dir_len_robot = 0.5 * robot_length;
        set(h_heading_robot, ...
            'XData', [p_robot(1), p_robot(1) + dir_len_robot*cos(theta_robot(k))], ...
            'YData', [p_robot(2), p_robot(2) + dir_len_robot*sin(theta_robot(k))]);

        % trailer
        dir_len_trailer = 0.5 * trailer_length;
        set(h_heading_trailer, ...
            'XData', [p_trailer(1), p_trailer(1) + (dir_len_trailer+xOffset)*cos(theta_trailer(k))], ...
            'YData', [p_trailer(2), p_trailer(2) + (dir_len_trailer+xOffset)*sin(theta_trailer(k))]);


        %cost on the left
        plot(ax2,time_array(1:k),cost.data(1:k),'k')

        drawnow;
        itm_formatfig(11, 'LineWidth', 1.5);
        
        if save_video
            frame = getframe(fig);
            writeVideo(v, frame);
        end

        pause(0.03);
    end
end